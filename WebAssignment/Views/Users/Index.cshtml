@model IEnumerable<WebAssignment.Models.User>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm">
            <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Error"]
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="gold-title mb-0">Manage Staff & Users</h2>
            <p class="text-muted small">View and manage all registered accounts.</p>
        </div>
        <a asp-action="CreateAdmin" class="btn btn-primary shadow-lg fw-bold px-4 py-2">
            <i class="bi bi-person-plus-fill me-2"></i> Add New Admin
        </a>
    </div>

    <div class="card p-0 shadow-lg" style="border: 1px solid var(--gold-dark); background-color: #121212; overflow: hidden;">
        <table class="table table-dark table-hover mb-0 align-middle" style="background: transparent;">
            <thead>
                <tr style="border-bottom: 2px solid var(--gold-main); background: #1a1a1a;">
                    <th class="text-warning ps-4 py-3">User</th>
                    <th class="text-warning py-3">Role</th>
                    <th class="text-warning py-3">Email</th>
                    <th class="text-end text-warning pe-4 py-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center gap-3">
                                @{
                                    var photoPath = !string.IsNullOrEmpty(item.ProfilePhotoPath)
                                    ? item.ProfilePhotoPath
                                    : "https://ui-avatars.com/api/?name=" + item.Username + "&background=random";
                                }
                                <img src="@photoPath" class="rounded-circle border border-secondary shadow-sm"
                                     style="width: 45px; height: 45px; object-fit: cover;">
                                <div>
                                    <span class="fw-bold text-white d-block">@item.Username</span>
                                    <small class="text-muted" style="font-size: 0.75rem;">@item.FullName</small>
                                </div>
                            </div>
                        </td>

                        <td>
                            @if (item.Role == WebAssignment.Models.UserRole.Admin)
                            {
                                <span class="badge bg-warning text-dark fw-bold shadow-sm px-3">ADMIN</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-white px-3">USER</span>
                            }
                        </td>

                        <td class="text-white-50">@item.Email</td>

                        <td class="text-end pe-4">

                            <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-warning me-2" title="Edit User">
                                <i class="bi bi-pencil-fill"></i>
                            </a>

                            @if (item.Username.ToLower() == "admin")
                            {
                                <button class="btn btn-sm btn-dark border-secondary text-muted" disabled title="Cannot Delete Super Admin" style="opacity: 0.7;">
                                    <i class="bi bi-shield-lock-fill"></i>
                                </button>
                            }
                            else
                            {
                                <a asp-action="Delete" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-danger" title="Delete User">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4">
        <a asp-controller="Movies" asp-action="Dashboard" class="btn btn-outline-light">
            <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
        </a>
    </div>
</div>