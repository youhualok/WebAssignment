@model WebAssignment.Models.Showtime
@{
    
    ViewData["Title"] = "Delete Schedule";
}

<div class="container mt-5">
    <h3>Are you sure you want to delete this showtime?</h3>
    <div class="card mt-3" style="max-width:500px">
        <div class="card-body">
            <h5>@Model.Movie.Title</h5>
            <p>@Model.Hall.Cinema.Name - @Model.Hall.Name</p>
            <p>@Model.StartTime.ToString("f")</p>
        </div>
    </div>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="ShowtimeId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>