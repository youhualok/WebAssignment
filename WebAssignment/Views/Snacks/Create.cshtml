@using System.Globalization
@inject WebAssignment.Helpers.LanguageService Lang
@model WebAssignment.Models.Snack

@{
    ViewData["Title"] = Lang.Get("Add New Snack");
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card p-4" style="border: 1px solid var(--gold-dark);">
        <h3 class="gold-title mb-4">@Lang.Get("Add New Snack")</h3>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="control-label">@Lang.Get("Snack Name")</label>
                <input asp-for="Name" class="form-control" placeholder="@Lang.Get("e.g. Super Combo")" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="control-label">@Lang.Get("Price") (RM)</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ImageUrl" class="control-label">@Lang.Get("Image URL")</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">@Lang.Get("Create")</button>
                <a asp-action="Index" class="btn btn-outline-dark">@Lang.Get("Cancel")</a>
            </div>
        </form>
    </div>
</div>