@using System.Globalization
@inject WebAssignment.Helpers.LanguageService Lang
@model WebAssignment.Models.Snack

@{
    ViewData["Title"] = Lang.Get("Delete Snack");
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card p-4 border-danger">
        <div class="text-center">
            <img src="@Model.ImageUrl" class="rounded mb-3" style="width: 150px; height: 150px; object-fit: cover;">
            <h3 class="text-white mb-2">@Lang.Get("Delete Snack")?</h3>
            <p class="text-muted">
                @Lang.Get("Are you sure you want to delete this snack?")
                <br>
                <strong>@Model.Name</strong>
            </p>
            <p class="text-warning fw-bold fs-4">RM @Model.Price.ToString("N2")</p>
        </div>

        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="SnackId" />
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-danger py-2">@Lang.Get("Yes, Delete!")</button>
                <a asp-action="Index" class="btn btn-outline-light">@Lang.Get("Cancel")</a>
            </div>
        </form>
    </div>
</div>