@using System.Globalization
@inject WebAssignment.Helpers.LanguageService Lang
@model IEnumerable<WebAssignment.Models.Snack>

@{
    ViewData["Title"] = Lang.Get("Manage Snacks");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="gold-title">@Lang.Get("Manage Snacks")</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> @Lang.Get("Add New Snack")
        </a>
    </div>

    <div class="card p-3" style="border: 1px solid var(--gold-dark);">
        <table class="table table-dark table-hover mb-0" style="background: transparent;">
            <thead>
                <tr style="border-bottom: 2px solid var(--gold-main);">
                    <th class="text-warning">@Lang.Get("Image")</th>
                    <th class="text-warning">@Lang.Get("Name")</th>
                    <th class="text-warning">@Lang.Get("Price")</th>
                    <th class="text-end text-warning">@Lang.Get("Actions")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="vertical-align: middle;">
                        <td>
                            <img src="@item.ImageUrl" alt="@item.Name"
                                 class="rounded" style="width: 60px; height: 60px; object-fit: cover; border: 1px solid #333;">
                        </td>
                        <td class="fw-bold text-white">@item.Name</td>
                        <td class="text-white">RM @item.Price.ToString("N2")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.SnackId" class="btn btn-sm btn-outline-warning me-2">
                                @Lang.Get("Edit")
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.SnackId" class="btn btn-sm btn-outline-danger">
                                @Lang.Get("Delete")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a asp-controller="Movies" asp-action="Dashboard" class="text-muted text-decoration-none">
            &larr; @Lang.Get("Back to Dashboard")
        </a>
    </div>
</div>