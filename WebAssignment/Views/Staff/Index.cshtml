@model IEnumerable<WebAssignment.Models.User>
@inject WebAssignment.Helpers.LanguageService Lang

@{
    ViewData["Title"] = Lang.Get("Manage Staff");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="gold-title mb-0">@Lang.Get("Manage Staff")</h2>
            <p class="text-muted">@Lang.Get("Create and manage Branch Admins.")</p>
        </div>
        <a asp-action="Create" class="btn btn-warning fw-bold px-4 py-2 shadow">
            <i class="bi bi-person-plus-fill me-2"></i>@Lang.Get("Add New Admin")
        </a>
    </div>

    <div class="card bg-dark border-0 shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr class="text-warning text-uppercase small border-secondary">
                        <th class="ps-4">@Lang.Get("Username")</th>
                        <th>@Lang.Get("Full Name")</th>
                        <th>@Lang.Get("Role Type")</th>
                        <th>@Lang.Get("Assigned Branch")</th>
                        <th class="text-end pe-4">@Lang.Get("Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-white">@item.Username</td>
                            <td>@item.FullName</td>
                            <td>
                                @if (item.ManagedCinemaId == null)
                                {
                                    <span class="badge bg-warning text-dark">@Lang.Get("SUPER ADMIN")</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">@Lang.Get("BRANCH MANAGER")</span>
                                }
                            </td>
                            <td>@(item.ManagedCinema?.Name ?? Lang.Get("Global Access"))</td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-light me-2"><i class="bi bi-pencil"></i> @Lang.Get("Edit")</a>
                                @if (User.Identity.Name != item.Username)
                                {
                                    <form asp-action="Delete" asp-route-id="@item.UserId" method="post" class="d-inline" onsubmit="return confirm('@Lang.Get("Are you sure you want to delete this admin?")');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> @Lang.Get("Delete")</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>
</div>
