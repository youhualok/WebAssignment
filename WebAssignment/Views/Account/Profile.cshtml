@model WebAssignment.Models.User

@{
    ViewData["Title"] = "My Profile";
}

<style>
    body {
        background-color: #000;
        color: white;
    }

    .profile-card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 0 20px rgba(212, 175, 55, 0.1);
        text-align: center;
        width: 100%;
        max-width: 760px;
        margin: 50px auto;
    }

    .profile-img {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        border: 4px solid #d4af37;
        object-fit: cover;
        margin-bottom: 20px;
        box-shadow: 0 0 15px rgba(212, 175, 55, 0.5);
    }

    .info-label {
        color: #888;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .info-value {
        font-size: 1.2rem;
        font-weight: bold;
        color: white;
        margin-bottom: 15px;
    }

    .points-badge {
        background-color: #d4af37;
        color: black;
        padding: 5px 15px;
        border-radius: 20px;
        font-weight: bold;
        display: inline-block;
        margin-bottom: 20px;
    }

    .btn-edit {
        background-color: transparent;
        border: 2px solid #d4af37;
        color: #d4af37;
        padding: 10px 30px;
        border-radius: 30px;
        font-weight: bold;
        transition: 0.3s;
        text-decoration: none;
        display: inline-block; /* Added to ensure buttons sit side-by-side */
    }

        .btn-edit:hover {
            background-color: #d4af37;
            color: black;
        }

    .profile-info-grid {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(140px, 1fr);
        gap: 30px;
        margin-top: 25px;
        text-align: left;
    }

    .profile-info-item {
        min-width: 0;
    }

        .profile-info-item .info-value {
            overflow-wrap: anywhere;
            word-break: break-word;
        }

    .profile-buttons {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 25px;
    }

    @@media (max-width: 650px) {
        .profile-card {
            padding: 25px 20px;
        }

        .profile-info-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .profile-buttons {
            flex-direction: column;
        }

        .btn-edit {
            width: 100%;
            margin-left: 0 !important;
            text-align: center;
        }
    }
</style>

<div class="container">
    <div class="profile-card">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-4">@TempData["Success"]</div>
        }

        <img src="@(string.IsNullOrEmpty(Model.ProfilePhotoPath) ? "https://ui-avatars.com/api/?name=" + Model.Username : Model.ProfilePhotoPath)"
             class="profile-img" alt="Profile Photo" />

        <div>
            @if (Model.Role == WebAssignment.Models.UserRole.Admin)
            {
                <span class="badge bg-danger mb-3">ADMINISTRATOR</span>
            }
            else
            {
                <span class="badge bg-secondary mb-3">MEMBER</span>
            }
        </div>

        <h2 style="color: #d4af37;">@Model.FullName</h2>
        <p class="text-muted">@Model.Username</p>

        <div class="points-badge">
            <i class="bi bi-star-fill"></i> @Model.Points Points
        </div>

        <hr style="border-color: #444;" />

        <div class="profile-info-grid">
            <div class="profile-info-item">
                <p class="info-label">Email Address</p>
                <p class="info-value">@Model.Email</p>
            </div>

            <div class="profile-info-item">
                <p class="info-label">Member Since</p>
                <p class="info-value">@DateTime.Now.Year</p>
            </div>
        </div>

        @* ======================================================== *@
        @* ADDED: CURRENT THEME INDICATOR (New Row)                 *@
        @* ======================================================== *@
        <div class="row text-start mt-2">
            <div class="col-md-12">
                <p class="info-label">Current Theme</p>
                <p class="info-value" style="color: var(--gold-main);">
                    <i class="bi bi-palette-fill me-2"></i> @(Model.ThemeColor ?? "Gold")
                </p>
            </div>
        </div>
        @* ======================================================== *@

        <div class="profile-buttons">
            <a asp-action="EditProfile" class="btn-edit">
                <i class="bi bi-pencil-square"></i> Edit Profile
            </a>

            @* ======================================================== *@
            @* ADDED: THEME SETTINGS BUTTON                             *@
            @* ======================================================== *@
            <a asp-controller="Account" asp-action="Settings" class="btn-edit">
                <i class="bi bi-palette"></i> Appearance
            </a>
        </div>

    </div>
</div>