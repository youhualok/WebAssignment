@model WebAssignment.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<style>
    body {
        background-color: #000;
        color: white;
    }

    .form-control {
        background-color: #1a1a1a !important;
        color: #ffffff !important;
        border: 1px solid #444;
        height: 50px;
        font-size: 1.1rem;
    }

        .form-control::placeholder {
            color: #888 !important;
            opacity: 1;
        }

        .form-control:focus {
            border-color: #d4af37 !important;
            box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
        }

    /* Fix Chrome Auto-Fill */
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    input:-webkit-autofill:active {
        -webkit-text-fill-color: #ffffff !important;
        -webkit-box-shadow: 0 0 0 50px #1a1a1a inset !important;
    }

    .btn-advanced {
        background-image: linear-gradient(to right, #d4af37 0%, #f2d06b 51%, #d4af37 100%);
        padding: 15px;
        text-align: center;
        text-transform: uppercase;
        transition: 0.5s;
        background-size: 200% auto;
        color: black;
        box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
        border-radius: 10px;
        border: none;
        font-weight: 900;
        width: 100%;
        display: block;
    }

        .btn-advanced:hover {
            background-position: right center;
            color: #000;
            transform: translateY(-2px);
        }
</style>

<div class="container mt-5 mb-5" style="max-width: 500px;">

    <div class="text-center mb-4">
        <i class="bi bi-key-fill display-1" style="color: #d4af37;"></i>
        <h2 class="mt-3" style="color: #d4af37;">NEW PASSWORD</h2>
        <p class="text-white-50">Please create a new strong password.</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center">@ViewBag.Error</div>
    }

    <form asp-action="ResetPassword" method="post" autocomplete="off">

        <div class="mb-3 text-start">
            <label class="fw-bold mb-2" style="color: #d4af37;">New Password</label>
            <input asp-for="NewPassword" type="password" class="form-control" placeholder="6+ chars, 1 number, 1 symbol" />
            <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="mb-4 text-start">
            <label class="fw-bold mb-2" style="color: #d4af37;">Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
        </div>

        <button type="submit" class="btn-advanced">
            RESET PASSWORD
        </button>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}