@model IEnumerable<WebAssignment.Models.Movie>
@inject WebAssignment.Helpers.LanguageService Lang

@{
    ViewData["Title"] = Lang.Get("Manage Movies");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="gold-title">@Lang.Get("Manage Movies")</h2>
        <a asp-action="Create" class="btn btn-warning fw-bold"><i class="bi bi-film me-2"></i>@Lang.Get("Add New Movie")</a>
    </div>

    <div class="card bg-dark border-0 shadow">
        <div class="table-responsive">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead>
                <tr class="text-warning">
                    <th style="width: 80px;">@Lang.Get("Poster")</th>
                    <th>@Lang.Get("Title")</th>
                    <th>@Lang.Get("Genre")</th>
                    <th>@Lang.Get("Status")</th>
                    <th>@Lang.Get("Actions")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><img src="@item.ImageUrl" class="rounded" style="width: 50px; height: 75px; object-fit: cover;"></td>
                        <td class="fw-bold">@item.Title</td>
                        <td>@item.Genre</td>
                        <td>
                            @if (item.Status == WebAssignment.Models.MovieStatus.NowShowing)
                            {
                                <span class="badge bg-success">@Lang.Get("Now Showing")</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Lang.Get("Coming Soon")</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.MovieId" class="btn btn-sm btn-outline-warning">@Lang.Get("Edit")</a>
                            <a asp-action="Delete" asp-route-id="@item.MovieId" class="btn btn-sm btn-outline-danger">@Lang.Get("Delete")</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>