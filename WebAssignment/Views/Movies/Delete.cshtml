@model WebAssignment.Models.Movie

@{
    ViewData["Title"] = "Delete";
}

<div class="container mt-5">
    <h3>Are you sure you want to delete this?</h3>

    <div class="card mt-4" style="max-width: 600px;">
        <div class="row g-0">
            <div class="col-md-4">
                <img src="@Model.ImageUrl" class="img-fluid rounded-start h-100" style="object-fit:cover;">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">@Model.Title</h5>
                    <p class="card-text">@Model.Genre</p>
                    <p class="card-text"><small class="text-muted">Released: @Model.ReleaseDate.ToString("d")</small></p>
                    <p class="card-text text-danger">Warning: Deleting this movie will remove it from all showtimes.</p>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="MovieId" />
        <button type="submit" class="btn btn-danger">Delete Movie</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>