@model WebAssignment.Models.Movie
@inject WebAssignment.Helpers.LanguageService Lang

@{
    ViewData["Title"] = Lang.Get("Edit Movie");
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card bg-dark border-secondary shadow">
                <div class="card-header bg-secondary bg-opacity-25 text-white fw-bold">
                    <i class="bi bi-pencil-square me-2"></i> @Lang.Get("Edit Movie")
                </div>
                <div class="card-body">
                    <form asp-action="Edit" enctype="multipart/form-data">

                        <input type="hidden" asp-for="MovieId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Title" class="form-label text-white">@Lang.Get("Title")</label>
                                <input asp-for="Title" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Genre" class="form-label text-white">@Lang.Get("Genre")</label>
                                <input asp-for="Genre" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="Genre" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DurationMinutes" class="form-label text-white">@Lang.Get("Duration (mins)")</label>
                                <input asp-for="DurationMinutes" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label text-white">@Lang.Get("Ticket Price (RM)")</label>
                                <input asp-for="Price" type="number" step="0.01" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ReleaseDate" class="form-label text-white">@Lang.Get("Release Date")</label>
                                <input asp-for="ReleaseDate" type="date" class="form-control bg-dark text-white border-secondary" />
                                <span asp-validation-for="ReleaseDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label text-white">@Lang.Get("Status")</label>
                                <select asp-for="Status" class="form-select bg-dark text-white border-secondary" asp-items="Html.GetEnumSelectList<WebAssignment.Models.MovieStatus>()"></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label text-white">@Lang.Get("Description")</label>
                                <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ImageUrl" class="form-label text-white">@Lang.Get("Image URL (Poster)")</label>
                                <input asp-for="ImageUrl" class="form-control bg-dark text-white border-secondary" placeholder="https://..." />
                                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TrailerUrl" class="form-label text-white">@Lang.Get("Trailer URL (YouTube)")</label>
                                <input asp-for="TrailerUrl" class="form-control bg-dark text-white border-secondary" placeholder="https://..." />
                                <span asp-validation-for="TrailerUrl" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">@Lang.Get("Cancel")</a>
                            <button type="submit" class="btn btn-warning fw-bold">@Lang.Get("Save Changes")</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}