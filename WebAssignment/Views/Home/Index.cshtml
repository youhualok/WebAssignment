@model IEnumerable<WebAssignment.Models.Movie>
@inject WebAssignment.Helpers.LanguageService Lang

@{
    ViewData["Title"] = "Home Page";
    var nowShowing = Model.Where(m => m.Status == WebAssignment.Models.MovieStatus.NowShowing).ToList();
    var comingSoon = Model.Where(m => m.Status == WebAssignment.Models.MovieStatus.ComingSoon).ToList();
}

<style>
    .promo-bar {
        background: linear-gradient(90deg, #b8860b, #d4af37, #ffd700, #d4af37, #b8860b);
        color: #000;
        padding: 12px 0;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        position: relative;
        z-index: 1050;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
        border-bottom: 2px solid #000;
    }

    .promo-text {
        display: inline-block;
        transition: opacity 0.5s ease-in-out;
    }

    .promo-code-box {
        background-color: #000;
        color: #d4af37;
        padding: 2px 8px;
        border-radius: 4px;
        margin-left: 5px;
        border: 1px solid #000;
    }

    .btn-close-custom {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        font-size: 1.2rem;
        cursor: pointer;
        color: #000;
        opacity: 0.6;
    }

        .btn-close-custom:hover {
            opacity: 1;
        }
</style>

<div id="promoNotification" class="promo-bar text-center" style="display:none;">
    <span class="promo-icon"><i class="bi bi-megaphone-fill me-2"></i></span>
    <span id="promoMessage" class="promo-text">
        🔥 Get 10% OFF Bundle Deals with code <span class="promo-code-box">WALIU10</span>
    </span>
    <button class="btn-close-custom" onclick="closePromo()"><i class="bi bi-x-lg"></i></button>
</div>

@section Hero {
    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=2070&auto=format&fit=crop" class="d-block w-100 full-screen-banner" alt="Cinema">
                <div class="carousel-caption d-none d-md-block">
                    <h2 class="display-3 fw-bold gold-text-shadow">@Lang.Get("Experience Luxury")</h2>
                    <p class="lead fs-4 text-white">@Lang.Get("Immersive sound. Premium seating. Golden service.")</p>
                    <a href="#movieSection" class="btn btn-primary btn-lg mt-3 px-5 shadow-lg">@Lang.Get("Book Ticket")</a>
                </div>
            </div>
            <div class="carousel-item">
                <img src="https://images.unsplash.com/photo-1585647347483-22b66260dfff?q=80&w=2070&auto=format&fit=crop" class="d-block w-100 full-screen-banner" alt="Snacks">
                <div class="carousel-caption d-none d-md-block">
                    <h2 class="display-3 fw-bold gold-text-shadow">@Lang.Get("Premium Snacks")</h2>
                    <p class="lead fs-4 text-white">@Lang.Get("Gourmet popcorn delivered straight to your seat.")</p>
                    <a asp-controller="Home" asp-action="Snacks" class="btn btn-primary btn-lg mt-3 px-5 shadow-lg">@Lang.Get("View Menu")</a>
                </div>
            </div>
            <div class="carousel-item">
                <img src="https://images.unsplash.com/photo-1536440136628-849c177e76a1?q=80&w=2025&auto=format&fit=crop" class="d-block w-100 full-screen-banner" alt="Movies">
                <div class="carousel-caption d-none d-md-block">
                    <h2 class="display-3 fw-bold gold-text-shadow">@Lang.Get("Blockbuster Hits")</h2>
                    <p class="lead fs-4 text-white">@Lang.Get("Watch the latest movies in IMAX 3D.")</p>
                    <a href="#movieSection" class="btn btn-primary btn-lg mt-3 px-5 shadow-lg">@Lang.Get("Browse Movies")</a>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Next</span>
        </button>
    </div>
}

<div class="container mt-5" id="movieSection">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4"><i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4"><i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <ul class="nav nav-pills justify-content-center mb-5" id="movieTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active px-5 py-2 fw-bold shadow-sm" id="now-tab" data-bs-toggle="pill" data-bs-target="#pills-now" type="button" role="tab" style="border-radius: 30px; margin-right: 15px;">
                @Lang.Get("NOW SHOWING")
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-5 py-2 fw-bold shadow-sm" id="soon-tab" data-bs-toggle="pill" data-bs-target="#pills-soon" type="button" role="tab" style="border-radius: 30px;">
                @Lang.Get("COMING SOON")
            </button>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">
        <div class="tab-pane fade show active" id="pills-now" role="tabpanel">
            <div class="row">
                @if (!nowShowing.Any())
                {
                    <div class="col-12 text-center py-5"><i class="bi bi-film display-4 text-muted mb-3"></i><h4 class="text-muted">@Lang.Get("No movies currently showing.")</h4></div>
                }
                @foreach (var movie in nowShowing)
                {
                    <div class="col-md-3 mb-4">
                        <div class="card h-100 shadow-sm border-0 hover-lift bg-dark text-white">
                            <a asp-action="Details" asp-route-id="@movie.MovieId">
                                <img src="@movie.ImageUrl" class="card-img-top" alt="@movie.Title" style="height: 400px; object-fit: cover; opacity: 0.9;">
                            </a>
                            <div class="card-body text-center d-flex flex-column position-relative">

                                @if (User.Identity.IsAuthenticated)
                                {
                                    // Check if this movie is in the list we sent from Controller
                                    var watchlistIds = ViewBag.WatchlistMovieIds as List<int> ?? new List<int>();
                                    bool isInWatchlist = watchlistIds.Contains(movie.MovieId);

                                    <button type="button"
                                            class="btn btn-link position-absolute top-0 end-0 p-2"
                                            onclick="toggleWatchlist(this, @movie.MovieId)"
                                            style="z-index: 10; color: white; margin-top: -10px; margin-right: -10px;">

                                        <i class="bi @(isInWatchlist ? "bi-heart-fill text-danger" : "bi-heart") fs-5"></i>
                                    </button>
                                }

                                <h5 class="card-title fw-bold text-truncate mb-auto text-warning">@movie.Title</h5>
                                <div class="mb-3 mt-2"><small class="text-muted">@movie.Genre &bull; @movie.DurationMinutes mins</small></div>
                                <a asp-action="Details" asp-route-id="@movie.MovieId" class="btn btn-primary w-100 fw-bold shadow-sm">
                                    @Lang.Get("Book Ticket")
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="tab-pane fade" id="pills-soon" role="tabpanel">
            <div class="row">
                @if (!comingSoon.Any())
                {
                    <div class="col-12 text-center py-5"><i class="bi bi-hourglass-split display-4 text-muted mb-3"></i><h4 class="text-muted">@Lang.Get("No upcoming movies announced.")</h4></div>
                }
                @foreach (var movie in comingSoon)
                {
                    <div class="col-md-3 mb-4">
                        <div class="card h-100 shadow-sm border-0 hover-lift bg-dark text-white" style="opacity: 0.85;">
                            <a asp-action="Details" asp-route-id="@movie.MovieId">
                                <img src="@movie.ImageUrl" class="card-img-top grayscale-img" alt="@movie.Title" style="height: 400px; object-fit: cover;">
                            </a>
                            <div class="card-body text-center d-flex flex-column position-relative">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    var watchlistIds = ViewBag.WatchlistMovieIds as List<int> ?? new List<int>();
                                    bool isInWatchlist = watchlistIds.Contains(movie.MovieId);
                                    <button type="button"
                                            class="btn btn-link position-absolute top-0 end-0 p-2"
                                            onclick="toggleWatchlist(this, @movie.MovieId)"
                                            style="z-index: 10; color: white; margin-top: -10px; margin-right: -10px;">
                                        <i class="bi @(isInWatchlist ? "bi-heart-fill text-danger" : "bi-heart") fs-5"></i>
                                    </button>
                                }
                                <h5 class="card-title fw-bold text-truncate mb-auto text-white">@movie.Title</h5>
                                <div class="mb-3 mt-2"><small class="text-warning fw-bold">Coming: @movie.ReleaseDate.ToString("dd MMM yyyy")</small></div>
                                <a asp-action="Details" asp-route-id="@movie.MovieId" class="btn btn-outline-light w-100">
                                    @Lang.Get("View Info")
                                </a>

                                @if (User.Identity.IsAuthenticated)
                                {
                                    <form asp-action="RemindMe" method="post" class="mt-2">
                                        <input type="hidden" name="id" value="@movie.MovieId" />
                                        <button type="submit" class="btn btn-warning w-100 fw-bold text-dark">
                                            <i class="bi bi-bell-fill me-2"></i> @Lang.Get("Remind Me")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-secondary w-100 mt-2">
                                        <i class="bi bi-lock-fill me-2"></i> @Lang.Get("Login to Remind")
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .full-screen-banner {
        width: 100vw;
        height: 650px;
        object-fit: cover;
        margin: 0;
        padding: 0;
        border-radius: 0 !important;
        filter: brightness(0.5);
    }

    .carousel-caption {
        bottom: 15%;
    }

    .hover-lift {
        transition: transform 0.3s, border-color 0.3s;
        border: 1px solid #333;
    }

        .hover-lift:hover {
            transform: translateY(-7px);
            border-color: var(--gold-main) !important;
            box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        }

    .nav-pills .nav-link {
        color: var(--gold-main);
        background-color: transparent;
        border: 1px solid var(--gold-main);
        transition: all 0.3s;
    }

        .nav-pills .nav-link:hover {
            background-color: rgba(212, 175, 55, 0.1);
        }

        .nav-pills .nav-link.active {
            background-color: var(--gold-main) !important;
            color: #000 !important;
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
        }

    .grayscale-img {
        filter: grayscale(40%);
        transition: filter 0.3s;
    }

        .grayscale-img:hover {
            filter: grayscale(0%);
        }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var myCarousel = document.querySelector('#heroCarousel');
            var carousel = new bootstrap.Carousel(myCarousel, { interval: 4000, ride: 'carousel', wrap: true });
            carousel.cycle();

            const promoBar = document.getElementById("promoNotification");
            setTimeout(() => { promoBar.style.display = "block"; }, 1000);

            const promos = [
                '🔥 Get 10% OFF Bundle Deals with code <span class="promo-code-box">WALIU10</span>',
                '🍿 Get 5% OFF Snacks with code <span class="promo-code-box">YUMMY5</span>',
                '✨ Experience the Magic at Waliu Cinema!'
            ];
            let currentIndex = 0;
            const messageElement = document.getElementById("promoMessage");
            setInterval(() => {
                messageElement.style.opacity = 0;
                setTimeout(() => {
                    currentIndex = (currentIndex + 1) % promos.length;
                    messageElement.innerHTML = promos[currentIndex];
                    messageElement.style.opacity = 1;
                }, 500);
            }, 4000);
        });
        function closePromo() {
            const bar = document.getElementById("promoNotification");
            bar.style.transition = "opacity 0.5s ease";
            bar.style.opacity = 0;
            setTimeout(() => bar.remove(), 500);
        }

        function toggleWatchlist(btn, movieId) {
            $.post('/Home/ToggleWatchlist', { movieId: movieId }, function (res) {
                if (res.success) {
                    var icon = $(btn).find('i');
                    if (res.isAdded) {
                        icon.removeClass('bi-heart').addClass('bi-heart-fill text-danger');
                    } else {
                        icon.removeClass('bi-heart-fill text-danger').addClass('bi-heart');
                    }
                } else {
                    alert("Error updating watchlist.");
                }
            }).fail(function() {
                 // Redirect to login if session expired or not logged in
                 window.location.href = '/Account/Login';
            });
        }
    </script>
}