@using System.Globalization
@inject WebAssignment.Helpers.LanguageService Lang
@model IEnumerable<WebAssignment.Models.Cinema>

@{
    ViewData["Title"] = Lang.Get("Manage Seats");
}

<div class="container mt-5">
    <h2 class="gold-title mb-4"><i class="bi bi-gear-fill me-2"></i> @Lang.Get("Manage Seats")</h2>
    <p class="text-muted">@Lang.Get("Select a hall to block/unblock seats.")</p>

    <div class="row">
        @foreach (var cinema in Model)
        {
            <div class="col-12 mb-4">
                <div class="card bg-dark text-white border-secondary">
                    <div class="card-header border-secondary">
                        <h4 class="mb-0 text-warning">@cinema.Name</h4>
                        <small class="text-muted">@cinema.Location</small>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-3">
                            @if (cinema.Halls != null)
                            {
                                foreach (var hall in cinema.Halls)
                                {
                                    <a asp-action="Manage" asp-route-hallId="@hall.HallId"
                                       class="btn btn-outline-light px-4 py-3">
                                        <i class="bi bi-grid-3x3 me-2"></i> @hall.Name
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>